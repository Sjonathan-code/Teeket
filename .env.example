# PostgreSQL
POSTGRES_DB=teeket
POSTGRES_USER=teeket
POSTGRES_PASSWORD=teeket_dev_password
POSTGRES_PORT=5432

# Shared database connection
DATABASE_URL=postgresql://teeket:teeket_dev_password@localhost:5432/teeket?schema=public

# API
API_PORT=3001
API_PREFIX=api
NODE_ENV=development
JWT_SECRET=replace_with_at_least_32_random_characters

# Web
NEXT_PUBLIC_API_URL=/api
DEV_ORIGIN=
