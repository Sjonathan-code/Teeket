{
  "name": "@teeket/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "echo \"No database package tests yet\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "pnpm run generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4"
  }
}
